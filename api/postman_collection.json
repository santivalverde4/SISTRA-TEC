  },
  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Guardar accessToken en environment variable para llamadas protegidas",
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json.accessToken) {",
              "    pm.environment.set('accessToken', json.accessToken);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test+admin@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"name\": \"Admin Test\",\n  \"role\": \"ADMIN_CENTER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
