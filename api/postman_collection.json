          ]
        }
      },
      "response": []
    },
    {
      "name": "Start Google OAuth (open in browser)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/google",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "google"
          ]
        },
        "description": "Abrir en navegador. Completa el inicio de sesión en Google. Después de aceptar, Google redirigirá a FRONTEND_URL/auth/google/complete?t=<TOKEN>. Copia el valor de t para el siguiente paso."
      },
      "response": []
    },
    {
      "name": "Complete Google Onboard",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tempToken\": \"<COPIA_AQUI_EL_TOKEN_T>\",\n  \"role\": \"<OPTIONAL_ROLE_O_EMPTY_PARA_LOGIN_EXISTENTE>\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/google/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "google",
            "complete"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Guarda accessToken si la respuesta es exitosa",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json.accessToken) {",
              "    pm.environment.set('accessToken', json.accessToken);",
              "  }",
              "  if (json.user && json.user.role) {",
              "    pm.environment.set('userRole', json.user.role);",
              "  }",
              "  // Comprueba que el header Set-Cookie contiene refreshToken",
              "  const setCookie = pm.response.headers.get('Set-Cookie') || '';",
              "  pm.test('refresh cookie set', function() { pm.expect(setCookie).to.include('refreshToken'); });",
              "} else {",
              "  pm.test('expected 200', function() { pm.expect(pm.response.code).to.eql(200); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
